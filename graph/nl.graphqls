# 框架自身的 API：auth 與 me。CRUD mutations 由 nl gen 生成（lists.graphqls）。

"""RFC 3339 時間，映射至 Go time.Time（見 gqlgen.yml models）"""
scalar Time

type AuthPayload {
  token: String!
  user: User!
}

type ApiKeyPayload {
  """明文金鑰，僅於簽發當下回傳一次"""
  key: String!
  name: String!
}

extend type Query {
  """目前登入的使用者"""
  me: User
}

extend type Mutation {
  login(email: String!, password: String!): AuthPayload!
  """為目前登入的使用者簽發 API key（供 MCP / server-to-server）"""
  createApiKey(name: String!): ApiKeyPayload!
}

"""網站專用金鑰；key 僅簽發時回傳，id 用於撤銷。"""
type ContentApiKeyPayload {
  id: ID!
  name: String!
  key: String!
}

extend type Mutation {
  """admin/moderator 簽發僅適用 /graphql/content 的 content:read 金鑰。"""
  createContentApiKey(name: String!): ContentApiKeyPayload!
  """admin/moderator 撤銷網站金鑰，已撤銷或不存在回傳 false。"""
  revokeContentApiKey(id: ID!): Boolean!
}
